global:
  resolve_timeout: 5m

route:
  group_by: ['alertname', 'name']
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h
  receiver: 'telegram'
  routes:
    - match:
        severity: critical
      receiver: 'telegram'
      repeat_interval: 1h
    - match:
        severity: warning
      receiver: 'telegram'
      repeat_interval: 4h

receivers:
  - name: 'telegram'
    telegram_configs:
      - bot_token: 'SEU_TOKEN_TELEGRAM_AQUI'
        chat_id: SEU_CHAT_ID_AQUI
        parse_mode: 'HTML'
        send_resolved: true
        message: |
          {{ if eq .Status "firing" -}}
          {{ if eq (index .Alerts 0).Labels.severity "critical" }}🔴 <b>ALERTA CRÍTICO</b>{{ else }}⚠️ <b>AVISO</b>{{ end }}
          {{- else }}
          ✅ <b>ALERTA RESOLVIDO</b>
          {{- end }}
          ━━━━━━━━━━━━━━━━━━━━━━━━

          {{ range .Alerts -}}
          🔔 <b>{{ .Labels.alertname }}</b>
          {{ if .Labels.name -}}
          📦 Container: <code>{{ .Labels.name }}</code>
          {{ end -}}
          {{ if eq $.Status "firing" -}}
          📝 {{ .Annotations.description }}
          ⏰ Disparado: {{ .StartsAt.Local.Format "02/01/2006 15:04:05" }} (BRT)
          {{- else -}}
          📝 {{ .Annotations.summary }} — retornou ao normal.
          ⏰ Resolvido: {{ .EndsAt.Local.Format "02/01/2006 15:04:05" }} (BRT)
          {{- end }}

          {{ end -}}
          ━━━━━━━━━━━━━━━━━━━━━━━━
          🖥️ <i>VPS Hostinger</i>

inhibit_rules:
  - source_match:
      severity: 'critical'
    target_match:
      severity: 'warning'
    equal: ['alertname', 'name']
