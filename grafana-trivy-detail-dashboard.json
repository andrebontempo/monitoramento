{
  "__inputs": [
    {
      "name": "DS_LOKI",
      "label": "Loki",
      "description": "",
      "type": "datasource",
      "pluginId": "loki",
      "pluginName": "Loki"
    }
  ],
  "__requires": [
    { "type": "datasource", "id": "loki", "name": "Loki", "version": "1.0.0" },
    { "type": "panel", "id": "stat", "name": "Stat", "version": "" },
    { "type": "panel", "id": "logs", "name": "Logs", "version": "" },
    { "type": "panel", "id": "bargauge", "name": "Bar gauge", "version": "" }
  ],
  "annotations": { "list": [] },
  "description": "Analise detalhada de CVEs por imagem Docker via Trivy + Loki",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 200,
      "title": "Resumo Geral — Todos os Containers",
      "type": "row"
    },

    {
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "dark-red", "value": 1 }] }, "unit": "short", "mappings": [] }, "overrides": [] },
      "gridPos": { "h": 4, "w": 5, "x": 0, "y": 1 },
      "id": 10,
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "center", "orientation": "auto", "reduceOptions": { "calcs": ["sum"], "fields": "", "values": false }, "textMode": "auto" },
      "targets": [{
        "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
        "expr": "sum(count_over_time({job=\"trivy-vuln\", severity=\"CRITICAL\"} [$__range]))",
        "queryType": "instant", "refId": "A", "legendFormat": "Critical"
      }],
      "title": "CRITICAL Total",
      "type": "stat"
    },

    {
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 1 }] }, "unit": "short", "mappings": [] }, "overrides": [] },
      "gridPos": { "h": 4, "w": 5, "x": 5, "y": 1 },
      "id": 11,
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "center", "orientation": "auto", "reduceOptions": { "calcs": ["sum"], "fields": "", "values": false }, "textMode": "auto" },
      "targets": [{
        "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
        "expr": "sum(count_over_time({job=\"trivy-vuln\", severity=\"HIGH\"} [$__range]))",
        "queryType": "instant", "refId": "A", "legendFormat": "High"
      }],
      "title": "HIGH Total",
      "type": "stat"
    },

    {
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 1 }] }, "unit": "short", "mappings": [] }, "overrides": [] },
      "gridPos": { "h": 4, "w": 5, "x": 10, "y": 1 },
      "id": 12,
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "center", "orientation": "auto", "reduceOptions": { "calcs": ["sum"], "fields": "", "values": false }, "textMode": "auto" },
      "targets": [{
        "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
        "expr": "sum(count_over_time({job=\"trivy-vuln\", severity=\"MEDIUM\"} [$__range]))",
        "queryType": "instant", "refId": "A", "legendFormat": "Medium"
      }],
      "title": "MEDIUM Total",
      "type": "stat"
    },

    {
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] }, "unit": "short", "mappings": [] }, "overrides": [] },
      "gridPos": { "h": 4, "w": 4, "x": 15, "y": 1 },
      "id": 13,
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "center", "orientation": "auto", "reduceOptions": { "calcs": ["sum"], "fields": "", "values": false }, "textMode": "auto" },
      "targets": [{
        "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
        "expr": "count_over_time({job=\"trivy\", severity=\"summary\"} | logfmt | status=\"scanned\" [$__range])",
        "queryType": "instant", "refId": "A", "legendFormat": "Imagens"
      }],
      "title": "Imagens Escaneadas",
      "type": "stat"
    },

    {
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "semi-dark-green", "value": null }] }, "unit": "short", "mappings": [] }, "overrides": [] },
      "gridPos": { "h": 4, "w": 5, "x": 19, "y": 1 },
      "id": 14,
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "center", "orientation": "auto", "reduceOptions": { "calcs": ["sum"], "fields": "", "values": false }, "textMode": "auto" },
      "targets": [{
        "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
        "expr": "sum(count_over_time({job=\"trivy-vuln\"} | logfmt | has_fix=\"yes\" [$__range]))",
        "queryType": "instant", "refId": "A", "legendFormat": "Com Correcao"
      }],
      "title": "CVEs com Correcao Disponivel",
      "type": "stat"
    },

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 201,
      "title": "Comparativo entre Imagens",
      "type": "row"
    },

    {
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "fieldConfig": { "defaults": { "color": { "mode": "continuous-RdYlGr" }, "thresholds": { "mode": "percentage", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 30 }, { "color": "red", "value": 70 }] }, "unit": "short", "min": 0 }, "overrides": [] },
      "gridPos": { "h": 12, "w": 8, "x": 0, "y": 6 },
      "id": 20,
      "options": { "displayMode": "gradient", "orientation": "horizontal", "reduceOptions": { "calcs": ["sum"], "fields": "", "values": false }, "showUnfilled": true },
      "targets": [{
        "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
        "expr": "sum by (image) (count_over_time({job=\"trivy-vuln\", severity=\"CRITICAL\"} [$__range]))",
        "legendFormat": "{{image}}", "queryType": "instant", "refId": "A"
      }],
      "title": "CRITICAL por Imagem",
      "type": "bargauge"
    },

    {
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "fieldConfig": { "defaults": { "color": { "mode": "continuous-BlYlRd" }, "thresholds": { "mode": "percentage", "steps": [{ "color": "blue", "value": null }, { "color": "yellow", "value": 30 }, { "color": "red", "value": 70 }] }, "unit": "short", "min": 0 }, "overrides": [] },
      "gridPos": { "h": 12, "w": 8, "x": 8, "y": 6 },
      "id": 21,
      "options": { "displayMode": "gradient", "orientation": "horizontal", "reduceOptions": { "calcs": ["sum"], "fields": "", "values": false }, "showUnfilled": true },
      "targets": [{
        "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
        "expr": "sum by (image) (count_over_time({job=\"trivy-vuln\", severity=\"HIGH\"} [$__range]))",
        "legendFormat": "{{image}}", "queryType": "instant", "refId": "B"
      }],
      "title": "HIGH por Imagem",
      "type": "bargauge"
    },

    {
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "fieldConfig": { "defaults": { "color": { "mode": "continuous-GrYlRd" }, "thresholds": { "mode": "percentage", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 30 }, { "color": "red", "value": 70 }] }, "unit": "short", "min": 0 }, "overrides": [] },
      "gridPos": { "h": 12, "w": 8, "x": 16, "y": 6 },
      "id": 22,
      "options": { "displayMode": "gradient", "orientation": "horizontal", "reduceOptions": { "calcs": ["sum"], "fields": "", "values": false }, "showUnfilled": true },
      "targets": [{
        "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
        "expr": "sum by (image) (count_over_time({job=\"trivy-vuln\", severity=\"MEDIUM\"} [$__range]))",
        "legendFormat": "{{image}}", "queryType": "instant", "refId": "C"
      }],
      "title": "MEDIUM por Imagem",
      "type": "bargauge"
    },

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 },
      "id": 202,
      "title": "Detalhamento por Imagem — Selecione: $image",
      "type": "row"
    },

    {
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "dark-red", "value": 1 }] }, "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 19 },
      "id": 30,
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "center", "reduceOptions": { "calcs": ["sum"] }, "textMode": "auto" },
      "targets": [{
        "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
        "expr": "count_over_time({job=\"trivy-vuln\", image=\"$image\", severity=\"CRITICAL\"} [$__range])",
        "queryType": "instant", "refId": "A", "legendFormat": "Critical"
      }],
      "title": "CRITICAL em $image",
      "type": "stat"
    },

    {
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 1 }] }, "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 19 },
      "id": 31,
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "center", "reduceOptions": { "calcs": ["sum"] }, "textMode": "auto" },
      "targets": [{
        "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
        "expr": "count_over_time({job=\"trivy-vuln\", image=\"$image\", severity=\"HIGH\"} [$__range])",
        "queryType": "instant", "refId": "A", "legendFormat": "High"
      }],
      "title": "HIGH em $image",
      "type": "stat"
    },

    {
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 1 }] }, "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 19 },
      "id": 32,
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "center", "reduceOptions": { "calcs": ["sum"] }, "textMode": "auto" },
      "targets": [{
        "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
        "expr": "count_over_time({job=\"trivy-vuln\", image=\"$image\", severity=\"MEDIUM\"} [$__range])",
        "queryType": "instant", "refId": "A", "legendFormat": "Medium"
      }],
      "title": "MEDIUM em $image",
      "type": "stat"
    },

    {
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "semi-dark-green", "value": null }] }, "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 19 },
      "id": 33,
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "center", "reduceOptions": { "calcs": ["sum"] }, "textMode": "auto" },
      "targets": [{
        "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
        "expr": "count_over_time({job=\"trivy-vuln\", image=\"$image\"} | logfmt | has_fix=\"yes\" [$__range])",
        "queryType": "instant", "refId": "A", "legendFormat": "Com fix"
      }],
      "title": "Com Correcao Disponivel",
      "type": "stat"
    },

    {
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "gridPos": { "h": 20, "w": 24, "x": 0, "y": 23 },
      "id": 40,
      "options": { "dedupStrategy": "none", "enableLogDetails": true, "prettifyLogMessage": false, "showCommonLabels": false, "showLabels": true, "showTime": true, "sortOrder": "Descending", "wrapLogMessage": false },
      "targets": [{
        "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
        "expr": "{job=\"trivy-vuln\", image=\"$image\", severity=~\"$severity\"} | logfmt",
        "queryType": "range", "refId": "A", "maxLines": 1000
      }],
      "title": "Todos os CVEs de: $image  (severidade: $severity)",
      "type": "logs"
    },

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 43 },
      "id": 203,
      "title": "Correcoes Disponiveis — Acao Recomendada",
      "type": "row"
    },

    {
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "gridPos": { "h": 16, "w": 24, "x": 0, "y": 44 },
      "id": 50,
      "options": { "dedupStrategy": "none", "enableLogDetails": true, "prettifyLogMessage": false, "showCommonLabels": false, "showLabels": true, "showTime": true, "sortOrder": "Descending", "wrapLogMessage": false },
      "targets": [{
        "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
        "expr": "{job=\"trivy-vuln\", image=\"$image\", severity=~\"CRITICAL|HIGH\"} | logfmt | has_fix=\"yes\"",
        "queryType": "range", "refId": "A", "maxLines": 500
      }],
      "title": "CVEs CRITICAL e HIGH com correcao disponivel em: $image",
      "type": "logs"
    }

  ],
  "refresh": "1h",
  "schemaVersion": 38,
  "tags": ["trivy", "security", "cve", "docker", "detailed"],
  "templating": {
    "list": [
      {
        "current": {},
        "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
        "definition": "label_values({job=\"trivy-vuln\"}, image)",
        "hide": 0,
        "includeAll": false,
        "label": "Imagem Docker",
        "multi": false,
        "name": "image",
        "options": [],
        "query": "label_values({job=\"trivy-vuln\"}, image)",
        "refresh": 2,
        "regex": "",
        "sort": 1,
        "type": "query"
      },
      {
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "hide": 0,
        "includeAll": true,
        "allValue": "CRITICAL|HIGH|MEDIUM|LOW|UNKNOWN",
        "label": "Severidade",
        "multi": true,
        "name": "severity",
        "options": [
          { "selected": true,  "text": "All",      "value": "$__all"   },
          { "selected": false, "text": "CRITICAL",  "value": "CRITICAL" },
          { "selected": false, "text": "HIGH",      "value": "HIGH"     },
          { "selected": false, "text": "MEDIUM",    "value": "MEDIUM"   },
          { "selected": false, "text": "LOW",       "value": "LOW"      }
        ],
        "query": "CRITICAL,HIGH,MEDIUM,LOW",
        "skipUrlSync": false,
        "type": "custom"
      }
    ]
  },
  "time": { "from": "now-7d", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Seguranca - CVEs por Imagem (Trivy Detalhado)",
  "uid": "trivy-detail-per-image-v2",
  "version": 1,
  "weekStart": ""
}
