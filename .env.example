# =============================================================
# EXEMPLO DE VARIÁVEIS DE AMBIENTE — Stack de Monitoramento
# Copie este arquivo para .env e preencha com seus dados reais:
#   cp .env.example .env
# =============================================================

# --- Grafana ---
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=TROQUE_PARA_SENHA_FORTE

# --- Telegram (alertmanager-bot) ---
# Token do bot criado via @BotFather no Telegram
TELEGRAM_TOKEN=SEU_TOKEN_AQUI

# Chat ID do administrador (use @userinfobot para descobrir)
TELEGRAM_ADMIN=SEU_CHAT_ID_AQUI
